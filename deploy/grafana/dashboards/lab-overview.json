{
  "uid": "lab-overview",
  "title": "Lab overview",
  "tags": [
    "lab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Running jobs",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "lab-prometheus"
          },
          "expr": "lab_running_attempts",
          "legendFormat": "running",
          "instant": true
        }
      ],
      "description": "Attempts holding a node right now.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Jobs waiting",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "lab-prometheus"
          },
          "expr": "sum(lab_queue_jobs)",
          "legendFormat": "queued",
          "instant": true
        }
      ],
      "description": "All classes together.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Queue per GPU class",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 16,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 40,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "lab-prometheus"
          },
          "expr": "lab_queue_jobs",
          "legendFormat": "{{gpu_class}}"
        }
      ],
      "description": "Jobs waiting for a node, by the class they asked for.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Nodes by state",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 40,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "lab-prometheus"
          },
          "expr": "lab_nodes",
          "legendFormat": "{{state}}"
        }
      ],
      "description": "idle / busy / offline / draining / quarantined.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Job outcomes",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 40,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "lab-prometheus"
          },
          "expr": "sum by (outcome) (increase(lab_jobs_finished_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "description": "Jobs that reached a final outcome in each interval.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Time to start (p50 / p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "lab-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(lab_time_to_start_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "lab-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lab_time_to_start_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "description": "From submission to the first attempt being created.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Image pull time (p50 / p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "lab-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(lab_image_pull_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "lab-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lab_image_pull_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "description": "Time lab PCs spend pulling job images.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Lease losses",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "lab-prometheus"
          },
          "expr": "increase(lab_lease_lost_total[$__rate_interval])",
          "legendFormat": "lease lost"
        }
      ],
      "description": "Attempts failed because their PC stopped renewing.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Job runtime (p50 / p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "lab-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(lab_job_runtime_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "lab-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lab_job_runtime_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Claims by result",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "lab-prometheus"
          },
          "expr": "sum by (result) (rate(lab_claims_total[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ],
      "description": "Agent claim requests per second. Mostly empty is normal: PCs poll for work.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Environment builds",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 40,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "lab-prometheus"
          },
          "expr": "lab_builds",
          "legendFormat": "{{state}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
