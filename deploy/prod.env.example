# Production settings. Copy to deploy/prod.env (git-ignored) and fill in all of it.
# Generate secrets with:  openssl rand -base64 36

# Hostnames that resolve to this server from the lab network.
PORTAL_HOST=lab.cse.uni.edu
API_HOST=lab-api.cse.uni.edu
REGISTRY_HOST=lab-registry.cse.uni.edu
GRAFANA_HOST=lab-grafana.cse.uni.edu
# "internal" = Caddy's own CA (lab PCs must trust it); or an email for Let's Encrypt.
LAB_TLS=internal

POSTGRES_PASSWORD=
MINIO_ROOT_USER=lab
MINIO_ROOT_PASSWORD=
TOKEN_PEPPER=

# Campus identity provider (Entra ID, Google Workspace, Keycloak, ...).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_EMAIL_DOMAINS=uni.edu
ADMIN_EMAILS=

# Registry push credentials for the builder PC. Hash with:
#   docker run --rm caddy:2.8.4 caddy hash-password --plaintext 'the-password'
REGISTRY_PUSH_USER=builder
REGISTRY_PUSH_HASH=

# Agent rollout: 0 canary only, 1 early group, 2 everyone. These are defaults;
# the portal's Rollout page overrides them (stored in the database).
AGENT_ROLLOUT_RING=2
AGENT_MIN_VERSION=

# Time zone of the class-hour schedules (an IANA name, e.g. Asia/Dhaka).
LAB_TIMEZONE=UTC

# Optional: POST alerts here (Slack/Teams/Discord-compatible incoming webhook).
ALERT_WEBHOOK_URL=

# Optional: e-mail users when their job finishes. Empty SMTP_HOST = no e-mail
# (users can still add a webhook in Settings).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=lab@localhost
SMTP_STARTTLS=1

# Monitoring. Prometheus scrapes the control plane's /metrics with METRICS_TOKEN
# (Caddy never serves /metrics on the API host). Grafana logs in as "admin".
METRICS_TOKEN=
GRAFANA_ADMIN_PASSWORD=
