# Copy to .env. LAN_HOST must be this machine's Wi-Fi IP so the other desktop can connect.
LAN_HOST=192.168.68.118
CONTROL_PORT=8080
# Campus image registry (registry:2). Empty = catalog images only; custom
# requirements.txt is rejected. Use a host lab PCs can reach, not 127.0.0.1.
# REGISTRY_URL=192.168.68.118:5001
# REGISTRY_PORT=5001
DEV_AUTH=1
DEV_AUTH_ADMIN=1
ADMIN_EMAILS=admin@uni.edu

# University OIDC. OIDC_DEV=1 is a local campus IdP at /oidc (email form).
# For real Entra/Google/Keycloak: OIDC_DEV=0 and set issuer + client id/secret.
OIDC_DEV=1
OIDC_ISSUER=http://127.0.0.1:8080/oidc
OIDC_CLIENT_ID=lab-portal
OIDC_CLIENT_SECRET=lab-oidc-dev-secret
OIDC_REDIRECT_URI=http://127.0.0.1:8080/auth/callback
PORTAL_BASE_URL=http://127.0.0.1:3000
# OIDC_ALLOWED_EMAIL_DOMAINS=uni.edu

POSTGRES_USER=lab
POSTGRES_PASSWORD=lab
POSTGRES_DB=lab

MINIO_ROOT_USER=labminio
MINIO_ROOT_PASSWORD=labminio
MINIO_BUCKET=lab

# Lease / heartbeat (seconds)
LEASE_TTL_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=10
DISCONNECT_GRACE_SECONDS=60
DISK_WATERMARK_BYTES=1073741824
TOKEN_PEPPER=dev-token-pepper-change-me
