# Copy to .env. LAN_HOST must be this machine's Wi-Fi IP so the other desktop can connect.
LAN_HOST=192.168.68.118
CONTROL_PORT=8080
# Campus image registry (registry:2). Empty = catalog images only; custom
# requirements.txt is rejected. Use a host lab PCs can reach, not 127.0.0.1.
# REGISTRY_URL=192.168.68.118:5001
# REGISTRY_PORT=5001
# With REGISTRY_URL set, a builder copies each catalog image into the registry
# (mirror build) so lab PCs pull from the LAN. 0 keeps pulling from Docker Hub.
# MIRROR_CATALOG_IMAGES=1
DEV_AUTH=1
DEV_AUTH_ADMIN=1
ADMIN_EMAILS=admin@uni.edu

# University OIDC. OIDC_DEV=1 is a local campus IdP at /oidc (email form).
# For real Entra/Google/Keycloak: OIDC_DEV=0 and set issuer + client id/secret.
OIDC_DEV=1
OIDC_ISSUER=http://127.0.0.1:8080/oidc
OIDC_CLIENT_ID=lab-portal
OIDC_CLIENT_SECRET=lab-oidc-dev-secret
OIDC_REDIRECT_URI=http://127.0.0.1:8080/auth/callback
PORTAL_BASE_URL=http://127.0.0.1:3000
# OIDC_ALLOWED_EMAIL_DOMAINS=uni.edu

POSTGRES_USER=lab
POSTGRES_PASSWORD=lab
POSTGRES_DB=lab

MINIO_ROOT_USER=labminio
MINIO_ROOT_PASSWORD=labminio
MINIO_BUCKET=lab

# Lease / heartbeat (seconds)
LEASE_TTL_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=10
DISCONNECT_GRACE_SECONDS=60
DISK_WATERMARK_BYTES=1073741824
TOKEN_PEPPER=dev-token-pepper-change-me

# Agent self-update. Empty target = the version in agent/agent.py.
# Nodes with update_ring <= AGENT_ROLLOUT_RING get it (0 canary, 1 early, 2 all).
# AGENT_ROLLOUT_RING=2
# AGENT_MIN_VERSION=
# These three are defaults: an admin can override them in the portal (stored in the
# database, picked up within 10 seconds), and clearing the override restores them.
# AGENT_SIGNING_KEY_PATH=   # default .dev/agent-signing-key.pem; keep it backed up

# Alerts (offline PCs, low disk, lease losses, flaky PCs, old queue) to a webhook.
# ALERT_WEBHOOK_URL=
# Alerts are kept in the database (acknowledge or mute them in the portal); the
# webhook announces each new one, and again after ALERT_COOLDOWN_SECONDS while open.
# ALERT_CHECK_SECONDS=60
# ALERT_COOLDOWN_SECONDS=3600

# E-mail when a job finishes (users can switch it off, or add a webhook, under
# Settings). Empty SMTP_HOST turns e-mail off; webhooks still work.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=lab@localhost
# SMTP_STARTTLS=1
# NOTIFY_CHECK_SECONDS=15   # how often finished jobs are looked for
# NOTIFY_MAX_TRIES=3        # failed deliveries per job before giving up

# Time zone of the availability schedules ("class hours"), an IANA name such as Asia/Dhaka.
# LAB_TIMEZONE=UTC

# Prometheus metrics at GET /metrics. With a token set, scrapers must send
# "Authorization: Bearer <token>". Empty = open (fine on a laptop).
# METRICS_TOKEN=

# Rate limits, requests a minute per signed-in user (per address when nobody is signed in).
# A request over the limit gets 429 with Retry-After. RATE_LIMIT_ENABLED=0 turns them off.
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_JOBS_PER_MINUTE=30         # POST /jobs
# RATE_LIMIT_INSPECT_PER_MINUTE=30      # POST /jobs/inspect
# RATE_LIMIT_LOGIN_PER_MINUTE=10        # POST /auth/local and GET /auth/login, per address
# RATE_LIMIT_CLIENT_ERRORS_PER_MINUTE=20  # POST /client-errors

# Log lines: "text" for a terminal, "json" (one object per line, with request_id) on the server.
# LOG_FORMAT=text

# Job-finished webhooks may only reach public addresses. Set 1 to let a webhook
# receiver on the lab network (private or loopback address) be used.
# NOTIFY_ALLOW_PRIVATE_WEBHOOKS=0
